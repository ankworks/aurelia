import("//ui/webui/resources/tools/build_webui.gni")

assert(!is_android)

# Generates :build_ts, :build_grd and :resources (GRIT headers, map and pak).
build_webui("build") {
  grd_prefix = "aurelia_newtab"
  static_files = [
    "newtab.html",
    "newtab.css",
    "design_tokens.css",
  ]
  ts_files = [ "newtab_app.ts" ]
  ts_deps = [ "//ui/webui/resources/js:build_ts" ]
  webui_context_type = "trusted"
}
