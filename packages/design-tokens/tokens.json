{
  "$comment": [
    "Aurelia design tokens - single source of truth for the browser UI.",
    "Consumed by:",
    "  - the Chromium WebUI overlay (chromium/overlay/chrome/browser/resources/aurelia/design_tokens.css)",
    "  - the development harness (packages/ui-lab)",
    "  - TypeScript consumers via packages/design-tokens/src/tokens.generated.ts",
    "Regenerate all outputs with: node tools/design/generate-tokens.mjs",
    "CI fails when a generated file is out of date, so a token can never exist in",
    "only one of the two worlds.",
    "Accessibility rule: every text/background pair below must reach WCAG 2.1 AA",
    "contrast (4.5:1 for body text). tools/design/check-contrast.mjs enforces it."
  ],
  "meta": {
    "name": "Aurelia M1 theme",
    "version": "0.2.0",
    "license": "MPL-2.0"
  },
  "color": {
    "accent": {
      "value": "#6e7bf2",
      "light": "#4f5bd5",
      "dark": "#8b95ff",
      "description": "Primary accent. The light/dark variants exist because a single accent cannot meet AA contrast on both backgrounds."
    },
    "accentText": {
      "light": "#fff",
      "dark": "#0b0d12",
      "description": "Text/icon colour placed on top of the accent colour."
    },
    "accentSubtle": {
      "light": "rgba(79, 91, 213, 0.10)",
      "dark": "rgba(139, 149, 255, 0.16)",
      "description": "Tinted accent background for chips and selected rows."
    },
    "background": {
      "light": "#f6f7fb",
      "dark": "#0e1015",
      "description": "Page background."
    },
    "backgroundElevated": {
      "light": "#fff",
      "dark": "#161922",
      "description": "Opaque surface used where transparency is unavailable (high contrast, reduced transparency, software rendering)."
    },
    "surface": {
      "light": "#fff",
      "dark": "#161922",
      "description": "Card/panel background - opaque by default."
    },
    "surfaceGlass": {
      "light": "rgba(255, 255, 255, 0.72)",
      "dark": "rgba(22, 25, 34, 0.66)",
      "description": "Translucent card surface. Always paired with a fallback to surface."
    },
    "surfaceGlassBorder": {
      "light": "rgba(255, 255, 255, 0.30)",
      "dark": "rgba(255, 255, 255, 0.10)",
      "description": "Border for glass surfaces - subtle white overlay for depth."
    },
    "omnibox": {
      "background": {
        "light": "#fff",
        "dark": "#1e2028",
        "description": "Omnibox input background."
      },
      "backgroundHover": {
        "light": "#f0f2f7",
        "dark": "#252830",
        "description": "Omnibox hover state."
      },
      "border": {
        "light": "rgba(20, 22, 28, 0.10)",
        "dark": "rgba(238, 240, 246, 0.10)",
        "description": "Omnibox border - subtle."
      },
      "text": {
        "light": "#14161c",
        "dark": "#eef0f6",
        "description": "Omnibox text."
      },
      "textMuted": {
        "light": "#8a90a2",
        "dark": "#7a8090",
        "description": "Omnibox placeholder/secondary text."
      }
    },
    "tab": {
      "background": {
        "inactive": {
          "light": "rgba(20, 22, 28, 0.03)",
          "dark": "rgba(238, 240, 246, 0.04)",
          "description": "Inactive tab background."
        },
        "active": {
          "light": "#fff",
          "dark": "#1e2028",
          "description": "Active tab background."
        },
        "hover": {
          "light": "rgba(20, 22, 28, 0.05)",
          "dark": "rgba(238, 240, 246, 0.06)",
          "description": "Tab hover state."
        }
      },
      "text": {
        "inactive": {
          "light": "#5a6072",
          "dark": "#a3a9bb",
          "description": "Inactive tab text."
        },
        "active": {
          "light": "#14161c",
          "dark": "#eef0f6",
          "description": "Active tab text."
        }
      },
      "border": {
        "value": "rgba(20, 22, 28, 0.10)",
        "description": "Tab separator border."
      }
    },
    "toolbar": {
      "background": {
        "light": "rgba(255, 255, 255, 0.80)",
        "dark": "rgba(22, 25, 34, 0.80)",
        "description": "Toolbar background with transparency."
      },
      "backgroundOpaque": {
        "light": "#fff",
        "dark": "#161922",
        "description": "Toolbar background fallback (no transparency)."
      }
    },
    "commandPalette": {
      "background": {
        "light": "#fff",
        "dark": "#1e2028",
        "description": "Command palette background."
      },
      "border": {
        "light": "rgba(20, 22, 28, 0.12)",
        "dark": "rgba(238, 240, 246, 0.12)",
        "description": "Command palette border."
      },
      "text": {
        "light": "#14161c",
        "dark": "#eef0f6",
        "description": "Command palette text."
      },
      "textMuted": {
        "light": "#8a90a2",
        "dark": "#7a8090",
        "description": "Command palette secondary text."
      },
      "highlight": {
        "light": "rgba(110, 123, 242, 0.12)",
        "dark": "rgba(139, 149, 255, 0.16)",
        "description": "Command palette selection highlight."
      }
    },
    "newTab": {
      "background": {
        "light": "#f6f7fb",
        "dark": "#0e1015",
        "description": "New tab page background."
      },
      "cardBackground": {
        "light": "#fff",
        "dark": "#161922",
        "description": "New tab card background."
      }
    },
    "text": {
      "light": "#14161c",
      "dark": "#eef0f6",
      "description": "Primary text."
    },
    "textMuted": {
      "light": "#5a6072",
      "dark": "#a3a9bb",
      "description": "Secondary text. Meets AA on the page background in both themes."
    },
    "border": {
      "light": "rgba(20, 22, 28, 0.12)",
      "dark": "rgba(238, 240, 246, 0.14)",
      "description": "Hairline borders and separators."
    },
    "success": {
      "light": "#1c7a4d",
      "dark": "#5fd39a",
      "description": "Positive status."
    },
    "warning": {
      "light": "#8a5a00",
      "dark": "#f0c05a",
      "description": "Caution status."
    },
    "danger": {
      "light": "#b3261e",
      "dark": "#ff8a80",
      "description": "Blocking or destructive status."
    }
  },
  "radius": {
    "xs": {
      "value": "4px"
    },
    "sm": {
      "value": "6px"
    },
    "md": {
      "value": "10px"
    },
    "lg": {
      "value": "16px"
    },
    "xl": {
      "value": "24px",
      "description": "Omnibox and command palette radius."
    },
    "pill": {
      "value": "999px"
    },
    "tab": {
      "value": "10px 10px 0 0",
      "description": "Tab corner radius (top rounded, bottom square)."
    },
    "tabActive": {
      "value": "10px 10px 0 0",
      "description": "Active tab corner radius."
    }
  },
  "space": {
    "xxs": {
      "value": "2px"
    },
    "xs": {
      "value": "4px"
    },
    "sm": {
      "value": "8px"
    },
    "md": {
      "value": "12px"
    },
    "lg": {
      "value": "16px"
    },
    "xl": {
      "value": "24px"
    },
    "xxl": {
      "value": "32px"
    },
    "xxxl": {
      "value": "48px",
      "description": "Large spacing for new tab layout."
    }
  },
  "type": {
    "family": {
      "value": "'Segoe UI Variable Text', 'Segoe UI', system-ui, -apple-system, 'SF Pro Text', Roboto, 'Helvetica Neue', Arial, sans-serif"
    },
    "familyMonospace": {
      "value": "'Cascadia Mono', 'SFMono-Regular', ui-monospace, Consolas, 'Liberation Mono', monospace"
    },
    "sizeXs": {
      "value": "11px"
    },
    "sizeSm": {
      "value": "12px"
    },
    "sizeBase": {
      "value": "13px"
    },
    "sizeLg": {
      "value": "15px"
    },
    "sizeXl": {
      "value": "18px",
      "description": "Omnibox and command palette text."
    },
    "sizeTitle": {
      "value": "22px"
    },
    "sizeDisplay": {
      "value": "32px",
      "description": "Large display text for new tab."
    },
    "weightRegular": {
      "value": "400"
    },
    "weightMedium": {
      "value": "500"
    },
    "weightSemibold": {
      "value": "600"
    }
  },
  "motion": {
    "durationFast": {
      "value": "120ms"
    },
    "durationNormal": {
      "value": "180ms"
    },
    "durationSlow": {
      "value": "240ms",
      "description": "Slower transitions for modal animations."
    },
    "easingStandard": {
      "value": "cubic-bezier(0.2, 0, 0, 1)"
    },
    "easingEaseOut": {
      "value": "cubic-bezier(0, 0, 0.2, 1)",
      "description": "Ease out for modal animations."
    }
  },
  "effect": {
    "blur": {
      "value": "12px",
      "description": "Backdrop blur radius for glass surfaces."
    },
    "blurStrong": {
      "value": "20px",
      "description": "Stronger blur for modal surfaces."
    },
    "shadowSm": {
      "value": "0 1px 2px rgba(20, 22, 28, 0.10)",
      "description": "Subtle shadow for elevated surfaces."
    },
    "shadowMd": {
      "value": "0 4px 12px rgba(20, 22, 28, 0.15)",
      "description": "Medium shadow for dropdowns and palettes."
    },
    "shadowLg": {
      "value": "0 8px 24px rgba(20, 22, 28, 0.20)",
      "description": "Large shadow for modals."
    },
    "focusRingWidth": {
      "value": "2px"
    },
    "focusRingOffset": {
      "value": "2px"
    }
  },
  "zIndex": {
    "commandPalette": {
      "value": "1000",
      "description": "Command palette z-index - above all content."
    },
    "dropdown": {
      "value": "500",
      "description": "Dropdown/omnibox suggestion z-index."
    },
    "modal": {
      "value": "1000",
      "description": "Modal dialog z-index."
    },
    "toast": {
      "value": "1100",
      "description": "Toast notification z-index."
    }
  }
}
